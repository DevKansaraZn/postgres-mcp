# Copy to .env and fill in your own values. NEVER commit .env.
#
# Option A -- a full connection URL (wins over everything below):
# DATABASE_URL=postgresql://readonly_user:secret@localhost:5432/mydb

# Option B -- individual settings:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# The standard libpq variables (PGHOST / PGPORT / PGUSER / PGPASSWORD /
# PGDATABASE) also work as a fallback, so an existing psql environment is
# picked up automatically.

# ---------------------------------------------------------------------------
# Optional limits (defaults shown). All are clamped to sane bounds.
# ---------------------------------------------------------------------------
# PG_MCP_MAX_ROWS=200                 # rows returned per query before truncation
# PG_MCP_MAX_CELL_CHARS=500           # per-cell character cap in rendered output
# PG_MCP_STATEMENT_TIMEOUT_MS=30000   # hard cap on how long a query may run
# PG_MCP_IDLE_TX_TIMEOUT_MS=60000
# PG_MCP_LOCK_TIMEOUT_MS=5000
# PG_MCP_CONNECT_TIMEOUT=10           # seconds
# PG_MCP_SSLMODE=require              # e.g. require / verify-full for remote DBs
# PG_MCP_APP_NAME=claude-postgres-mcp-ro   # shows up in pg_stat_activity
# PG_MCP_ALLOW_SYSTEM_SCHEMAS=false   # include pg_catalog/information_schema in listings
